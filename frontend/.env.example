# CareerPilot AI — Frontend Environment Variables (Example)
# Copy to .env.local or .env for local development

# Base URL for backend API (Spring Boot)
VITE_API_BASE_URL=http://localhost:8080/api

# Supabase Client Configuration (Public anon key only - NEVER put service role key here)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
