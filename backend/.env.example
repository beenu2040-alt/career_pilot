# CareerPilot AI — Backend Environment Variables (Example)
# Copy this file to .env or export these variables in your deployment environment.
# DO NOT commit real secrets or credentials to source control.

# Application Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Supabase PostgreSQL Database Configuration
# Obtain connection string details from Supabase Dashboard -> Project Settings -> Database
# Example pooler URL: jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://<db.your-project-ref.supabase.co>:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=<your-supabase-database-password>

# Database Connection Pool Settings
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# CORS Configuration
# Comma-separated list of allowed origins for development / production
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
