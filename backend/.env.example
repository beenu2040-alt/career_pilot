# CareerPilot AI — Backend Environment Variables (Example)
# Copy this file to .env or export these variables in your deployment environment.
# DO NOT commit real secrets or credentials to source control.

# Application Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Supabase PostgreSQL Database Configuration
# Obtain connection string details from Supabase Dashboard -> Project Settings -> Database
# Example pooler URL: jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://<db.your-project-ref.supabase.co>:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=<your-supabase-database-password>

# Database Connection Pool Settings
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# Flyway Database Migrations (Set to true once connected to Supabase PostgreSQL)
FLYWAY_ENABLED=false

# Supabase Authentication & JWT Validation
# Choose either Option A (HMAC-SHA256 Secret) or Option B (JWKS Endpoint)
# Option A: Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret-minimum-32-chars>

# Supabase Storage Configuration (Phase 4 Resume Storage)
# Required for private Supabase Storage bucket uploads. If omitted, falls back to local private storage.
# Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role key (KEEP SECRET!)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
SUPABASE_STORAGE_BUCKET=resumes
RESUME_MAX_FILE_SIZE=10485760

# AI Provider Configuration (Phase 4 Resume Analysis)
# Supported providers: gemini (default), openai, fallback (deterministic analyzer requiring no external API key)
AI_PROVIDER=gemini
AI_API_KEY=<your-gemini-or-openai-api-key>
AI_MODEL=gemini-1.5-flash

# Option B: For projects using asymmetric RS256/ES256 keys or Supabase Auth JWKS:
# SUPABASE_JWT_JWK_SET_URI=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_AUTH_ISSUER_URI=https://<your-project-ref>.supabase.co/auth/v1

# CORS Configuration
# Comma-separated list of allowed origins for development / production
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
